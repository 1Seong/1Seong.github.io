{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(node .claude/scripts/check-portfolio.mjs:*)",
      "Bash(bash .claude/scripts/fetch-repo.sh:*)",
      "Bash(node .claude/scripts/shot.mjs:*)",
      "Bash(git -C C:/Users/PC/AppData/Local/Temp/repos/:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(gh repo view:*)",
      "Bash(gh repo clone:*)",
      "Bash(gh search code:*)",
      "Edit(/portfolio-data.js)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-on-edit.mjs\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
